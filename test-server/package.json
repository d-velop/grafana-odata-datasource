{
  "name": "grafana-odata-datasource-test-server",
  "version": "1.0.0",
  "description": "A simple test server for the Grafana OData Data Source Plugin",
  "scripts": {
    "start": "ts-node generateTestdata.ts && cds-ts deploy && cds-ts serve"
  },
  "author": "d.velop AG",
  "license": "Apache-2.0",
  "dependencies": {
    "@cap-js/sqlite": "^3.1.2",
    "@eslint/js": "^10.0.1",
    "@sap/cds": "^10.1.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "jose": "^6.2.13",
    "morgan": "^1.12.1",
    "openid-client": "^6.8.8",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "uuid": "^14.0.3",
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "@sap/cds-dk": "^10.1.2",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.28.2",
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      }
    },
    "log": {
      "service": true
    },
    "features": {
      "odata_new_parser": true
    }
  }
}
